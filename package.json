{
  "name": "dsh-siwc-plugin-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -b tsconfig.host.json && tsdown --config tsdown.config.ts",
    "build:client": "tsc -b tsconfig.client.json && tsdown --config tsdown.client.config.ts",
    "typecheck": "tsc -b tsconfig.host.json && tsc -b tsconfig.client.json",
    "test": "pnpm --filter @f12o/dsh-siwc test",
    "pack": "pnpm run build && pnpm --filter @f12o/dsh-siwc pack"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.2",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
